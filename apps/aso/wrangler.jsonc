// Read by Cloudflare Workers Builds (git deployment) only; nothing runs Wrangler locally.
{
  "name": "aso-mcp",
  "main": "src/index.ts",
  // nodejs_compat (on by default from 2026-08-04) populates process.env from vars and secrets.
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // @repo/core is consumed from its compiled dist/, so build it before the Worker is bundled.
  "build": { "command": "pnpm --filter @repo/core build" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  // Non-production branch builds run `wrangler preview`, which requires this block.
  "previews": {
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      },
      "issue_detection": {
        "enabled": true
      }
    }
  }
}
