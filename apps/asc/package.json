{
  "name": "@tartinerlabs/app-store-connect-mcp",
  "version": "0.9.0",
  "description": "Unofficial Model Context Protocol server for read-only App Store Connect access with per-user API keys, with Sign in with Google (OAuth 2.1 via Better Auth) on Cloudflare Workers and D1.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:generate": "auth generate --output src/db/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@repo/core": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.4",
    "@types/node": "catalog:",
    "auth": "catalog:",
    "cf": "1.0.0-beta.10",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
